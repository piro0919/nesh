# Supabase (local: from `pnpm db:start` output / prod: from Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app (used for apiBase shown in dashboard)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret (set to a strong random string in prod; any non-empty value locally)
CRON_SECRET=local-dev-secret

# 32-byte AES-256-GCM key for encrypting VAPID private keys at rest (base64)
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
VAPID_KEY_ENCRYPTION_KEY=
